# Cloudflare R2 — needed only for shareable links
# Leave blank to run without share link support
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neiro

# Cobalt — needed only for the YouTube import feature.
# Deploy cobalt_app.py first (`uv run modal deploy cobalt_app.py`), then
# copy COBALT_URL / COBALT_API_KEY from that file here.
COBALT_URL=
COBALT_API_KEY=
