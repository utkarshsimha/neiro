# Cloudflare R2 — needed only for shareable links
# Leave blank to run without share link support
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neiro

# Cobalt — needed only for the YouTube import feature.
# `make deploy-cobalt` deploys cobalt_app.py, generates a new key and prints
# COBALT_URL / COBALT_API_KEY to copy here. To recover the current key without
# changing it:
#   uv run modal shell --secret cobalt --cmd 'echo "$COBALT_API_KEY"'
COBALT_URL=
COBALT_API_KEY=
